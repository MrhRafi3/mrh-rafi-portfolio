
import {
  motion,
  useMotionValue,
  useReducedMotion,
  useSpring,
  useScroll,
  useTransform,
} from 'motion/react'
import { useRef } from 'react'
import './index.css'

const easeOut = [0.22, 1, 0.36, 1]

const profileLinks = [
  {
    label: 'GitHub profile',
    href: 'https://github.com/mrirafi/mrirafi',
    symbol: '↗',
  },
  {
    label: 'LinkedIn profile',
    href: 'https://bd.linkedin.com/in/mrhrafi',
    symbol: '↗',
  },
]

const clockFeatures = [
  { number: '01', name: 'Clock', detail: 'Time at a glance', icon: '◷' },
  { number: '02', name: 'Alarm', detail: 'Start your day', icon: '◉' },
  { number: '03', name: 'Stopwatch', detail: 'Every second counts', icon: '◎' },
]

function App() {
  const shouldReduceMotion = useReducedMotion()

  const heroRef = useRef(null)
  const introRef = useRef(null)
  const workRef = useRef(null)
  const aboutRef = useRef(null)
  const skillsRef = useRef(null)
  const contactRef = useRef(null)

  // Home zooms out as it leaves the top of the screen.
  const { scrollYProgress: heroProgress } = useScroll({
    target: heroRef,
    offset: ['start start', 'end start'],
  })
  const heroScale = useTransform(heroProgress, [0, 1], [1, 0.86])

  // Other sections zoom in near the middle and out as you pass them.
  const { scrollYProgress: introProgress } = useScroll({
    target: introRef,
    offset: ['start end', 'end start'],
  })
  const introScale = useTransform(
    introProgress, [0, 0.5, 1], [0.88, 1, 0.88],
  )

  const { scrollYProgress: workProgress } = useScroll({
    target: workRef,
    offset: ['start end', 'end start'],
  })
  const workScale = useTransform(
    workProgress, [0, 0.5, 1], [0.88, 1, 0.88],
  )

  const { scrollYProgress: aboutProgress } = useScroll({
    target: aboutRef,
    offset: ['start end', 'end start'],
  })
  const aboutScale = useTransform(
    aboutProgress, [0, 0.5, 1], [0.88, 1, 0.88],
  )

  const { scrollYProgress: skillsProgress } = useScroll({
    target: skillsRef,
    offset: ['start end', 'end start'],
  })
  const skillsScale = useTransform(
    skillsProgress, [0, 0.5, 1], [0.88, 1, 0.88],
  )

  const { scrollYProgress: contactProgress } = useScroll({
    target: contactRef,
    offset: ['start end', 'end start'],
  })
  const contactScale = useTransform(
    contactProgress, [0, 0.5, 1], [0.88, 1, 0.88],
  )

  // Smooth spring values keep the phone tilt natural.
  const phoneRotateXValue = useMotionValue(0)
  const phoneRotateYValue = useMotionValue(0)

  const phoneRotateX = useSpring(phoneRotateXValue, {
    stiffness: 180,
    damping: 22,
  })

  const phoneRotateY = useSpring(phoneRotateYValue, {
    stiffness: 180,
    damping: 22,
  })

  const handlePhoneMouseMove = (event) => {
    if (shouldReduceMotion) return

    const bounds = event.currentTarget.getBoundingClientRect()
    const x = (event.clientX - bounds.left) / bounds.width
    const y = (event.clientY - bounds.top) / bounds.height

    phoneRotateXValue.set((0.5 - y) * 12)
    phoneRotateYValue.set((x - 0.5) * 14)
  }

  const handlePhoneMouseLeave = () => {
    phoneRotateXValue.set(0)
    phoneRotateYValue.set(0)
  }

  const reveal = (delay = 0, distance = 24) => ({
    initial: shouldReduceMotion ? false : { opacity: 0, y: distance },
    animate: { opacity: 1, y: 0 },
    transition: {
      duration: shouldReduceMotion ? 0 : 0.8,
      delay: shouldReduceMotion ? 0 : delay,
      ease: easeOut,
    },
  })

  const scrollReveal = (distance = 32) => ({
    initial: shouldReduceMotion ? false : { opacity: 0, y: distance },
    whileInView: { opacity: 1, y: 0 },
    viewport: { once: true, amount: 0.2 },
    transition: {
      duration: shouldReduceMotion ? 0 : 0.75,
      ease: easeOut,
    },
  })

  const linkHover = shouldReduceMotion
