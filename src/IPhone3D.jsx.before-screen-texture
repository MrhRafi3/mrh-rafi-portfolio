}

export default function IPhone3D({ reducedMotion = false }) {
  const [rotation, setRotation] = useState(0)

  return (
    <div className="iphone-3d-wrap">
      <Canvas
        dpr={[1, 1.5]}
        camera={{ position: [0, 0, 6.5], fov: 34 }}
        gl={{
          antialias: true,
          alpha: true,
          powerPreference: 'high-performance',
        }}
        onCreated={({ gl }) => {
          gl.outputColorSpace = THREE.SRGBColorSpace
          gl.toneMapping = THREE.ACESFilmicToneMapping
        }}
      >
        <ambientLight intensity={1.2} />
        <hemisphereLight args={['#ffffff', '#b8b1a7', 1.5]} />
        <directionalLight
          position={[4, 5, 5]}
          intensity={2.4}
          color="#fff8ef"
        />
        <directionalLight
          position={[-4, 1, -3]}
          intensity={1.8}
          color="#dce5ff"
        />

        <Suspense fallback={<LoadingPhone />}>
          <PhoneModel
            reducedMotion={reducedMotion}
            rotation={rotation}
            setRotation={setRotation}
          />
          <ContactShadows
            position={[0, -2.15, 0]}
            opacity={0.28}
            scale={4.5}
            blur={2.8}
            far={4}
          />
          <Environment preset="studio" />
        </Suspense>
      </Canvas>

      <div className="rotation-hint">↔ &nbsp; 360° ROTATION</div>
    </div>
  )
}

