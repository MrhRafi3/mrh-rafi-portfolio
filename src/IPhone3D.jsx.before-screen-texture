function PhoneModel({ reducedMotion, rotation, setRotation }) {
  const group = useRef(null)
  const dragging = useRef(false)
  const lastX = useRef(0)
  const { scene } = useGLTF('/models/iphone.glb')

  const fitted = useMemo(() => {
    const model = scene.clone(true)
    const bounds = new THREE.Box3().setFromObject(model)
    const size = bounds.getSize(new THREE.Vector3())
    const center = bounds.getCenter(new THREE.Vector3())
    const maxDimension = Math.max(size.x, size.y, size.z) || 1
    const scale = 3.7 / maxDimension

    model.traverse((object) => {
      if (object.isMesh) {
        object.castShadow = true
        object.receiveShadow = true
      }
    })

    return {
      model,
      scale,
      position: [
        -center.x * scale,
        -center.y * scale,
        -center.z * scale,
      ],
    }
  }, [scene])

  useFrame((state, delta) => {
    if (!group.current) return

    if (!dragging.current && !reducedMotion) {
      setRotation((previous) => previous + delta * 0.35)
    }

    group.current.rotation.y = Math.PI + rotation
    group.current.rotation.x = Math.sin(state.clock.elapsedTime * 0.35) * 0.025
  })

  const handlePointerDown = (event) => {
    event.stopPropagation()
    dragging.current = true
    lastX.current = event.clientX
    event.target.setPointerCapture?.(event.pointerId)
  }

  const handlePointerMove = (event) => {
    if (!dragging.current) return
    const difference = event.clientX - lastX.current
    lastX.current = event.clientX
    setRotation((previous) => previous + difference * 0.01)
  }

  const handlePointerUp = () => {
    dragging.current = false
  }

  return (
    <group
      onPointerDown={handlePointerDown}
      onPointerMove={handlePointerMove}
      onPointerUp={handlePointerUp}
      onPointerLeave={handlePointerUp}
    >
      <Float
        speed={reducedMotion ? 0 : 1.2}
        floatIntensity={reducedMotion ? 0 : 0.12}
        rotationIntensity={0}
      >
        <group ref={group}>
          <primitive
            object={fitted.model}
            scale={fitted.scale}
            position={fitted.position}
          />

          {/* Screen overlay: adjust position/rotation to match your GLB screen */}
          
<Html
  transform
  position={[0, 0, 0.5]}
  rotation={[0, 0, 0]}
  scale={0.25}
  distanceFactor={4.5}
  zIndexRange={[100, 0]}
  style={{
    width: '300px',
    height: '610px',
    pointerEvents: 'none',
    overflow: 'hidden',
    borderRadius: '34px',
    background: '#0b0d0c',
  }}
>
  <ProjectScreen />
</Html>

        </group>
      </Float>
    </group>
  )
}

